{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "qfd",
  "version": "0.1.1",
  "identifier": "com.tauri-app.qfd",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "小桔抢福代工具",
        "width": 1000,
        "height": 626,
        "resizable": true,
        "decorations": true,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "sqlite": {
      "preload": ["sqlite:sqlite.db"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
